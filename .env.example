# 이 파일을 복사해서 .env 로 이름을 바꾸고 값을 채우세요. (.env 는 GitHub 에 올라가지 않아요)
# Vercel 에도 아래 이름 그대로 환경변수로 넣습니다. 서버 전용 비밀 키에는 VITE_ 를 붙이지 마세요.

# 1. Claude — 다국어 AI 가이드 (필수) · console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
# (선택) 모델 이름을 바꾸고 싶을 때
ANTHROPIC_MODEL=

# 2. Supabase — 입항 일정·기사·예약(실시간)·이용 기록 (권장)
#    Project Settings → API. 없으면 이 브라우저 안에서만 동작하는 '로컬 데모 모드'로 돌아가요.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 3. 비짓제주 — 주변 음식점·쇼핑 (선택) · Golden Hour 에서 쓰던 키 그대로 사용 가능
VISITJEJU_API_KEY=

# 4. 카카오 — 지도 + 실제 이동 시간 (선택, 권장)
#    developers.kakao.com → 내 애플리케이션 → 앱 만들기
#    ① REST API 키 → KAKAO_REST_KEY (서버 전용) : 카카오모빌리티 다중 경유지 길찾기 → 코스 구간별 실제 시간·도로 경로
#       (앱 설정 → 카카오내비 API 사용 ON). 없으면 어림 계산(직선 × 1.35 ÷ 시속 35km + 5분)
#    ② JavaScript 키 → VITE_KAKAO_JS_KEY (브라우저용 공개 키) : 카카오맵 지도
#       (앱 설정 → 플랫폼 → Web 에 http://localhost:5173 과 Vercel 주소 등록). 없으면 OpenStreetMap 지도
KAKAO_REST_KEY=
VITE_KAKAO_JS_KEY=

# 키가 필요 없는 API: Open-Meteo(강정항 날씨)
